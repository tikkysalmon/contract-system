# คัดลอกไฟล์นี้เป็น scripts/.env แล้วกรอกค่าจริง (ไฟล์ scripts/.env ห้าม commit ขึ้น git เด็ดขาด — ถ้าใช้
# ในโฟลเดอร์ contract-system อยู่แล้วใน .gitignore ให้ด้วย)
#
# ODOO_* — ค่าจริงหาได้จาก 17_Agent_ตรวจสอบ_Odoo\.env (เชื่อมต่อบัญชีเดียวกัน)
ODOO_URL=http://203.34.221.168:8069
ODOO_DB=odoo_salmonphone
ODOO_USERNAME=
ODOO_PASSWORD=

# CRM_* — ค่าเดียวกับที่ตั้งไว้ใน Vercel project settings ของ contract-system
CRM_USERNAME=
CRM_PASSWORD=

# SUPABASE_* — ค่าเดียวกับที่ตั้งไว้ใน Vercel project settings ของ contract-system (Settings > Environment
# Variables) หรือดูจาก Supabase project dashboard ของระบบทำสัญญาเอง (Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CRM_ORDERS_SYNC_FROM_DATE (ไม่บังคับ, รูปแบบ YYYY-MM-DD) — 2026-09-30 user ขอ: sync คำสั่งขาย CRM ไม่ให้ดึง
# "ทั้งหมด" มาเขียนทับ Supabase ทุกรอบ (ทำให้ระบบหน่วง) — ตั้งวันที่นี้ไว้เพื่อเก็บเฉพาะคำสั่งขายตั้งแต่วันที่
# กำหนดเป็นต้นมาเท่านั้น (CRM ยังต้องดึงทั้งหมดมาก่อนเสมอเพราะ API ไม่รองรับ filter วันที่ฝั่ง server แต่ส่วนนี้
# ลดจำนวนแถวที่ต้องประมวลผล/เขียนเข้า Supabase จริงลงไปมาก) ถ้าไม่ตั้งค่า ใช้ค่าเริ่มต้นย้อนหลัง 60 วันจากวันที่
# รันจริงให้อัตโนมัติ
CRM_ORDERS_SYNC_FROM_DATE=
